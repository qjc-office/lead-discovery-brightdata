# Copy to .env and fill in. .env is gitignored and must never be committed.
# Load with:  set -a && source .env && set +a

# Bright Data API key.
# Account settings > API keys: https://brightdata.com/cp/setting/users
# Docs: https://docs.brightdata.com/api-reference/authentication
BRIGHTDATA_API_KEY=

# Slack incoming webhook for change alerts.
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------- usecases/
# 아래는 usecases/ 파이프라인의 보강 단계에서만 쓴다.
# 없어도 파이프라인은 돌고, 해당 보강 단계만 건너뛴다.

# 국세청 사업자등록상태 조회 (공공데이터포털)
# https://www.data.go.kr/data/15081808/openapi.do
DATA_GO_NTS_API_KEY=

# DART 공시대상 법인 명부 (금융감독원 오픈 API)
# https://opendart.fss.or.kr/
DART_API_KEY=

# usecases/content-radar의 자사 채널 실적 조회(YouTube Analytics API)에서만 쓴다.
# 없으면 공개 지표만으로 그대로 동작한다. Google Cloud Console에서 OAuth 클라이언트를
# 만들고 refresh token을 한 번 발급받아 넣는다.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_QJC_CLIENT_ID=
YOUTUBE_QJC_CLIENT_SECRET=
YOUTUBE_QJC_REFRESH_TOKEN=
